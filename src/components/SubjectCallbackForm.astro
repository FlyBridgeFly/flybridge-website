---
import FormShell from "./FormShell.astro";
import { site } from "../data/site";
import { createCallbackFields } from "../lib/callback-form";

interface Props {
  keyStage: string;
  subject: string;
  sourcePage?: string;
}

const { keyStage, subject, sourcePage = "/" } = Astro.props;

const fields = createCallbackFields({
  enquiryType: "subject-callback",
  sourcePage,
  keyStage,
  subject,
  messagePlaceholder: "Share current attainment, confidence or timetable constraints if helpful."
});
---

<FormShell
  title="Discuss your child’s next steps"
  body="Tell FlyBridge about your child and choose a preferred callback time. The assessment or next step will be confirmed with you directly."
  fields={fields}
  submitLabel="Request callback"
  helper="Your preferred date and time help FlyBridge plan the callback. The prepared email still needs to be sent from your mail app."
  subject={`FlyBridge callback request: ${subject} (${keyStage})`}
  recipientEmail={site.email}
  secondaryLabel="WhatsApp FlyBridge"
  secondaryHref={site.whatsappHref}
/>
