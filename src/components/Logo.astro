---
import { site } from "../data/site";

interface Props {
  variant?: "default" | "light";
  context?: "header" | "footer";
}

const { variant = "default", context = "header" } = Astro.props;
const logoSrc = variant === "light" ? site.images.logoLight : site.images.logo;
const isHeader = context === "header";
const isFooter = context === "footer";
---

<a href="/" class="inline-flex min-w-0 items-center" aria-label="FlyBridge Education home">
  <img
    src={logoSrc}
    alt="FlyBridge Education"
    class:list={[
      "w-auto object-contain",
      isHeader
        ? "h-[2.625rem] sm:h-12 md:h-[3rem] lg:h-[3.6rem] xl:h-[3.9rem]"
        : isFooter
          ? "max-w-[12.5rem] sm:max-w-[13.75rem] lg:max-w-[15rem] xl:max-w-[15.5rem]"
          : "h-9 max-w-[11rem] sm:h-10 sm:max-w-[12rem]"
    ]}
    loading="eager"
    decoding="async"
  />
</a>
