---
interface Props {
  title: string;
  body?: string;
  tableId: string;
  cardsId?: string;
  actionsSlotLabel?: string;
}

const { title, body, tableId, cardsId = `${tableId}-cards`, actionsSlotLabel = "Actions" } = Astro.props;
---

<section class="dashboard-section">
  <div class="admin-toolbar">
    <div class="dashboard-section-heading">
      <h2 class="text-xl font-semibold tracking-tight text-fb-ink sm:text-2xl">{title}</h2>
      {body && <p class="body-copy-compact">{body}</p>}
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <slot name="actions" />
    </div>
  </div>
  <div class="mt-4 hidden overflow-hidden rounded-[1rem] border border-slate-200 bg-white lg:block" data-admin-table-shell={tableId}>
    <div class="overflow-x-auto" data-admin-table-scroll={tableId}>
      <table class="w-full min-w-[820px] text-left text-sm" data-admin-table={tableId}>
        <thead class="border-b border-slate-200 bg-slate-50/90 text-slate-500" data-admin-table-head-wrap={tableId}>
          <tr data-admin-table-head={tableId}></tr>
        </thead>
        <tbody data-admin-table-body={tableId}></tbody>
      </table>
    </div>
  </div>
  <div class="mt-4 grid gap-3 lg:hidden" data-admin-cards={cardsId}></div>
</section>
