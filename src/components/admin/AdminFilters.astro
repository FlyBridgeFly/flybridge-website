---
interface Props {
  containerId: string;
}

const { containerId } = Astro.props;
---

<section class="dashboard-section">
  <div class="dashboard-section-heading">
    <h2 class="text-lg font-semibold text-fb-ink">Filters</h2>
  </div>
  <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-4" data-admin-filters={containerId}>
    <slot />
  </div>
</section>
