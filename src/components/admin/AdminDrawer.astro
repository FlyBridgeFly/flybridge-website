---
interface Props {
  drawerId: string;
  title?: string;
}

const { drawerId, title = "Details" } = Astro.props;
---

<aside class="fixed inset-y-0 right-0 z-[72] hidden w-full max-w-[32rem] border-l border-white/70 bg-white/[0.98] shadow-2xl shadow-slate-900/15 backdrop-blur-xl" data-admin-drawer={drawerId} aria-hidden="true">
  <div class="flex h-full flex-col overflow-y-auto">
    <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-4 py-4 sm:px-5">
      <div class="min-w-0">
        <p class="text-xs font-semibold tracking-[0.18em] text-slate-500 uppercase">Admin detail</p>
        <h2 class="mt-2 text-xl font-semibold text-fb-ink" data-admin-drawer-title={drawerId}>{title}</h2>
      </div>
      <button class="ghost-button px-4" data-admin-drawer-close={drawerId} type="button">Close</button>
    </div>
    <div class="flex-1 px-4 py-4 sm:px-5" data-admin-drawer-body={drawerId}></div>
  </div>
</aside>
<div class="fixed inset-0 z-[71] hidden bg-slate-950/30 backdrop-blur-[2px]" data-admin-drawer-backdrop={drawerId}></div>
