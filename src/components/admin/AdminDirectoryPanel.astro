---
interface Props {
  panel: "students" | "tutors" | "parents";
  title: string;
}

const { panel, title } = Astro.props;
---

<section class="directory-panel" data-directory-panel={panel} data-directory-title={title}>
  <div class="space-y-6">
    <slot />
  </div>
  <button
    class="directory-expand-button"
    data-directory-expand={panel}
    title="Open full-screen view"
    aria-label={`Open full-screen view for ${title}`}
    type="button"
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true">
      <path d="M8 4.75H4.75V8M16 4.75h3.25V8M8 19.25H4.75V16M19.25 16v3.25H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M9 5H5v4M15 5h4v4M5 15v4h4M19 15v4h-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" opacity="0.65"></path>
    </svg>
    <span class="sr-only">Open full-screen view</span>
  </button>
  <button class="directory-close-button" data-directory-close={panel} type="button">Close</button>
</section>
