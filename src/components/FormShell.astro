---
interface Field {
  label: string;
  name: string;
  type?: "text" | "email" | "tel" | "textarea" | "hidden" | "date" | "select";
  placeholder: string;
  helper?: string;
  required?: boolean;
  autocomplete?: string;
  value?: string;
  readOnly?: boolean;
  span?: "full";
  min?: string;
  options?: readonly {
    value: string;
    label: string;
  }[];
}

interface Props {
  id?: string;
  title: string;
  body: string;
  fields: readonly Field[];
  submitLabel: string;
  helper: string;
  subject?: string;
  recipientEmail?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  trustPoints?: readonly {
    title: string;
    body: string;
  }[];
}

const {
  id,
  title,
  body,
  fields,
  submitLabel,
  helper,
  subject = "FlyBridge enquiry",
  recipientEmail,
  secondaryLabel,
  secondaryHref,
  trustPoints = []
} = Astro.props;
---

<div id={id} class="form-panel">
  <div class="min-w-0 space-y-3">
    <h2 class="text-xl font-semibold tracking-tight text-fb-ink sm:text-2xl">{title}</h2>
    <p class="max-w-2xl body-copy-compact">{body}</p>
  </div>
  {trustPoints.length > 0 && (
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {trustPoints.map((item) => (
        <div class="dashboard-list-item">
          <p class="text-xs font-semibold tracking-[0.16em] text-slate-500 uppercase">{item.title}</p>
          <p class="mt-2 text-sm leading-6 text-fb-ink-soft">{item.body}</p>
        </div>
      ))}
    </div>
  )}
  <form
    class="mt-6 space-y-4"
    action="#"
    method="post"
    data-form-shell
    data-form-subject={subject}
    data-form-recipient={recipientEmail ?? ""}
  >
    <div class="form-grid-compact mt-0">
      {fields.map((field) =>
        field.type === "hidden" ? (
          <input
            type="hidden"
            name={field.name}
            value={field.value ?? ""}
            data-label={field.label}
          />
        ) : field.type === "textarea" ? (
          <label class:list={[field.span === "full" && "md:col-span-2"]}>
            <span class="label-shell">{field.label}</span>
            <textarea
              class="input-shell min-h-[6rem] resize-y"
              name={field.name}
              placeholder={field.placeholder}
              data-label={field.label}
              readonly={field.readOnly}
              required={field.required}
              autocomplete={field.autocomplete}
            >{field.value ?? ""}</textarea>
            {field.helper && <span class="helper-shell">{field.helper}</span>}
          </label>
        ) : field.type === "select" ? (
          <label class:list={[field.span === "full" && "md:col-span-2"]}>
            <span class="label-shell">{field.label}</span>
            <select
              class="input-shell"
              name={field.name}
              data-label={field.label}
              required={field.required}
              autocomplete={field.autocomplete}
            >
              <option value="">{field.placeholder || "Select an option"}</option>
              {field.options?.map((option) => (
                <option value={option.value} selected={option.value === (field.value ?? "")}>
                  {option.label}
                </option>
              ))}
            </select>
            {field.helper && <span class="helper-shell">{field.helper}</span>}
          </label>
        ) : (
          <label class:list={[field.span === "full" && "md:col-span-2"]}>
            <span class="label-shell">{field.label}</span>
            <input
              class="input-shell"
              type={field.type ?? "text"}
              name={field.name}
              placeholder={field.placeholder}
              data-label={field.label}
              value={field.value ?? ""}
              min={field.min}
              readonly={field.readOnly}
              required={field.required}
              autocomplete={field.autocomplete}
            />
            {field.helper && <span class="helper-shell">{field.helper}</span>}
          </label>
        )
      )}
    </div>
    <div class="surface-note">
      {helper}
    </div>
    <p class="status-message hidden" data-form-feedback role="status" aria-live="polite"></p>
    <div class="form-actions mt-0">
      <button class="cta-button w-full sm:w-auto" type="submit">{submitLabel}</button>
      {secondaryLabel && secondaryHref && <a class="ghost-button w-full sm:w-auto" href={secondaryHref}>{secondaryLabel}</a>}
    </div>
  </form>
</div>

<script is:inline>
  document.querySelectorAll("[data-form-shell]").forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;

    const feedback = form.querySelector("[data-form-feedback]");
    const recipient = form.dataset.formRecipient;
    const subject = form.dataset.formSubject ?? "FlyBridge enquiry";

    const formatDateForEmail = (value) => {
      if (!value) return value;
      const date = new Date(`${value}T00:00:00`);
      if (Number.isNaN(date.getTime())) return value;
      return new Intl.DateTimeFormat("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric"
      }).format(date);
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const lines = Array.from(form.querySelectorAll("input, textarea, select"))
        .filter((field) => field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)
        .map((field) => {
          const label = field.dataset.label ?? field.name;
          const rawValue = field.value.trim();
          const value =
            field instanceof HTMLInputElement && field.type === "date" ? formatDateForEmail(rawValue) : rawValue;
          return value ? `${label}: ${value}` : null;
        })
        .filter(Boolean)
        .join("\n");

      if (!recipient) {
        if (feedback instanceof HTMLElement) {
          feedback.classList.remove("hidden");
          feedback.classList.remove("status-success", "status-info");
          feedback.classList.add("status-error");
          feedback.textContent = "This form is missing a recipient email address.";
        }
        return;
      }

        if (feedback instanceof HTMLElement) {
          feedback.classList.remove("hidden");
          feedback.classList.remove("status-error", "status-success");
          feedback.classList.add("status-info");
          feedback.textContent = "Your email app is opening with a prepared FlyBridge enquiry draft. Please review it and press send.";
        }

      const mailto = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines)}`;
      window.location.href = mailto;
    });
  });
</script>
