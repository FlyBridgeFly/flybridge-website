---
import Logo from "./Logo.astro";
import { footerCompanyLinks, footerKeyStageLinks, footerLegalLinks, footerPortalLinks, footerSupportLinks, site } from "../data/site";
---

<footer class="mt-14 bg-fb-bg text-fb-text sm:mt-16">
  <div class="container-shell grid gap-10 py-10 sm:gap-12 sm:py-12 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,0.82fr)_minmax(0,0.82fr)_minmax(0,0.82fr)_minmax(0,0.82fr)] lg:gap-x-10 xl:gap-x-12">
    <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
      <div class="w-full max-w-[15.5rem] sm:max-w-[14rem] lg:max-w-[15rem] xl:max-w-[15.5rem]">
        <Logo context="footer" />
      </div>
      <p class="mt-6 max-w-md text-sm leading-7 text-slate-300 sm:text-[15px]">
        Qualified teachers delivering structured tuition, clear parent reporting and measurable academic progress.
      </p>
      <div class="mt-6 flex flex-col items-center gap-3 text-sm text-slate-300 sm:items-start">
        <a class="footer-link break-words" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="footer-link" href={site.whatsappHref} target="_blank" rel="noreferrer">{site.phone}</a>
      </div>
      <a
        class="focus-pill mt-7 inline-flex items-center justify-center rounded-full bg-white px-5 py-3 text-sm font-semibold text-fb-bg transition hover:bg-sky-50"
        href={site.assessmentHref}
      >
        Book Assessment
      </a>
    </div>
    <nav class="space-y-4 text-center sm:text-left" aria-label="Footer key stage links">
      <p class="text-xs font-semibold tracking-[0.22em] text-slate-400 uppercase">Key Stages</p>
      <div class="flex flex-col gap-3">
        {footerKeyStageLinks.map((item) => (
          <a class="footer-link" href={item.href}>{item.label}</a>
        ))}
      </div>
    </nav>
    <nav class="space-y-4 text-center sm:text-left" aria-label="Footer company links">
      <p class="text-xs font-semibold tracking-[0.22em] text-slate-400 uppercase">Company</p>
      <div class="flex flex-col gap-3">
        {footerCompanyLinks.map((item) => (
          <a class="footer-link" href={item.href}>{item.label}</a>
        ))}
      </div>
    </nav>
    <nav class="space-y-4 text-center sm:text-left" aria-label="Footer support links">
      <p class="text-xs font-semibold tracking-[0.22em] text-slate-400 uppercase">Support</p>
      <div class="flex flex-col gap-3">
        {footerSupportLinks.map((item) => (
          <a class="footer-link" href={item.href}>{item.label}</a>
        ))}
      </div>
    </nav>
    <nav class="space-y-4 text-center sm:text-left" aria-label="Footer portal links">
      <p class="text-xs font-semibold tracking-[0.22em] text-slate-400 uppercase">Portal</p>
      <div class="flex flex-col gap-3">
        {footerPortalLinks.map((item) => (
          <a class="footer-link" href={item.href}>{item.label}</a>
        ))}
      </div>
    </nav>
    <div class="grid gap-8 text-center sm:text-left">
      <div class="space-y-4">
        <p class="text-xs font-semibold tracking-[0.22em] text-slate-400 uppercase">Contact</p>
        <div class="flex flex-col gap-3">
          <a class="footer-link" href={site.whatsappHref} target="_blank" rel="noreferrer">WhatsApp</a>
          <a class="footer-link" href={`mailto:${site.email}`}>Email</a>
          <a class="footer-link" href={site.contactHref}>Contact Page</a>
        </div>
      </div>
      <div class="space-y-4">
        <p class="text-xs font-semibold tracking-[0.22em] text-slate-400 uppercase">Legal</p>
        <div class="flex flex-col gap-3">
          {footerLegalLinks.map((item) => (
            <a class="footer-link" href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-shell flex flex-col gap-2 py-5 text-center text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <p>© {new Date().getFullYear()} FlyBridge Education. All rights reserved.</p>
      <p>Qualified-teacher tuition with clear parent reporting.</p>
    </div>
  </div>
</footer>
