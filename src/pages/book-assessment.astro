---
import BaseLayout from "../layouts/BaseLayout.astro";
import FormShell from "../components/FormShell.astro";
import { site } from "../data/site";
import { createCallbackFields } from "../lib/callback-form";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Book a Free Assessment",
  description: "Request a free assessment callback with FlyBridge Education.",
  url: new URL("/book-assessment", site.url).toString()
};

const fields = createCallbackFields({
  enquiryType: "assessment-callback",
  sourcePage: "/book-assessment",
  subject: "Assessment enquiry",
  yearGroupPlaceholder: "For example: Year 10 or KS4",
  messagePlaceholder: "Share current understanding, knowledge gaps, concerns or anything important before the callback."
});
---

<BaseLayout
  title="Book a Free Assessment"
  description="Request a free assessment callback with FlyBridge Education."
  path="/book-assessment"
  schema={schema}
>
  <section class="container-shell section-shell-tight">
    <div class="grid gap-5 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div class="space-y-4">
        <span class="eyebrow">Book assessment</span>
        <h1 class="text-balance text-[2rem] font-semibold tracking-tight text-fb-ink sm:text-[2.5rem]">Book a free assessment</h1>
        <p class="max-w-2xl body-copy-compact">Tell us about your child and choose a preferred callback time. FlyBridge will contact you to discuss their needs and arrange the assessment.</p>
        <a class="ghost-button w-full sm:w-auto" href="#assessment-callback-form">Request a callback</a>
        <div class="stack-divider rounded-[1.2rem] border border-slate-200 bg-white/80 p-4 sm:p-5">
          <div>
            <p class="text-sm font-semibold text-fb-ink">What the assessment covers</p>
            <p class="mt-2 text-sm leading-6 text-fb-ink-soft">Current understanding, confidence, curriculum fit and the gaps most worth addressing first.</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-fb-ink">What FlyBridge reviews</p>
            <p class="mt-2 text-sm leading-6 text-fb-ink-soft">Knowledge gaps, likely misconceptions, suitable lesson format and the right level of support.</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-fb-ink">What happens next</p>
            <p class="mt-2 text-sm leading-6 text-fb-ink-soft">Your selected date and hour are a preference, not a confirmed appointment. FlyBridge will confirm the assessment arrangement with you directly.</p>
          </div>
        </div>
      </div>
      <FormShell
        title="Request an assessment callback"
        body="Choose a preferred callback date and hour so FlyBridge can get in touch and confirm the assessment arrangement."
        fields={fields}
        submitLabel="Request assessment callback"
        helper="A prepared email draft will open with your details. Please review it and press send."
        subject="FlyBridge assessment callback request"
        recipientEmail={site.email}
        secondaryLabel="WhatsApp FlyBridge"
        secondaryHref={site.whatsappHref}
        id="assessment-callback-form"
      />
    </div>
  </section>
</BaseLayout>
